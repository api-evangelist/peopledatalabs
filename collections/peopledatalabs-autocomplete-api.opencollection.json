{
  "opencollection": "1.0.0",
  "info": {
    "name": "api.peopledatalabs.com Autocomplete API",
    "version": "5.0"
  },
  "items": [
    {
      "info": {
        "name": "Autocomplete",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "/autocomplete",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.peopledatalabs.com/v5/autocomplete",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "field",
                "value": "",
                "type": "query",
                "description": "An enumerated field that will be used to calculate the autocompletion"
              },
              {
                "name": "text",
                "value": "",
                "type": "query",
                "description": "Text that is used as the seed for autocompletion"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Numbers of results returned for autocompletion"
              },
              {
                "name": "titlecase",
                "value": "",
                "type": "query",
                "description": "Setting to `true` will titlecase any records returned"
              },
              {
                "name": "pretty",
                "value": "",
                "type": "query",
                "description": "Whether the output should have human-readable indentation"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Autocompletes a limited amount of fields."
        },
        {
          "info": {
            "name": "/autocomplete",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.peopledatalabs.com/v5/autocomplete",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "/autocomplete"
        }
      ]
    }
  ],
  "bundled": true
}